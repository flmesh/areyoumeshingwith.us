{
  "name": "areyoumeshingwith.us",
  "description": "Florida Mesh website.",
  "scripts": {
    "csdev": "hugo server --gc --enableGitInfo -DF -b / --appendPort=false",
    "dev": "npm run mapgen && hugo server --gc --enableGitInfo -DF",
    "prod": "hugo server --gc --disableFastRender --enableGitInfo --minify -e production -p 1314",
    "mapgen": "cd tools/mapgen && go run main.go",
    "build": "npm run mapgen && hugo --gc --minify -e production"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flmesh/areyoumeshingwith.us.git"
  },
  "author": "Jeremy T. Bouse <jeremy.bouse@undergrid.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/flmesh/areyoumeshingwith.us/issues"
  },
  "homepage": "https://github.com/flmesh/areyoumeshingwith.us#readme",
  "dependencies": {
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@hbstack/node-packages": "^0.1.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.10",
    "postcss-cli": "^12.0.0"
  }
}
